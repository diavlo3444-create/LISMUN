# GEMINI_API_KEY: Optional Gemini API key (server-side only).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (used for self-referential links & OAuth callbacks).
APP_URL=

# DATABASE_URL: Required Neon PostgreSQL connection string (postgresql://...?sslmode=require).
DATABASE_URL=

# PRIMARY_SUPER_ADMIN_EMAIL: Root unremovable Super Admin email address.
PRIMARY_SUPER_ADMIN_EMAIL=

# RESEND_API_KEY & EMAIL_FROM: Required for automated bulk HR & decision email dispatch via Resend.
RESEND_API_KEY=
EMAIL_FROM=

# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GMAIL_TOKEN_ENCRYPTION_KEY: Optional Shared Gmail OAuth2 credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=


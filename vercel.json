{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/server/db/migrations/**/*.sql"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index?__lismun_path=$1" },
    { "source": "/((?!api$|api/|assets/|src/).*)", "destination": "/index.html" }
  ]
}
